{
  "name": "maggietseng-markdown-to-pdf",
  "displayName": "Easy Markdown to PDF",
  "description": "Turn Markdown into PDF with live preview and simple layout settings, entirely on your computer.",
  "version": "0.2.4",
  "publisher": "MaggieTseng",
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui"
  ],
  "main": "./dist/extension.cjs",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "localMarkdownPdf.export",
        "title": "Markdown: Export to PDF"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "localMarkdownPdf.export",
          "when": "editorLangId == markdown",
          "group": "1_modification@20"
        }
      ]
    },
    "configuration": {
      "title": "Markdown to PDF",
      "properties": {
        "localMarkdownPdf.codeTheme": {
          "type": "string",
          "enum": [
            "one-light",
            "github-dark"
          ],
          "enumItemLabels": [
            "One Light",
            "GitHub Dark"
          ],
          "enumDescriptions": [
            "Light code blocks with soft colors (default).",
            "Dark code blocks on a light document."
          ],
          "default": "one-light",
          "scope": "resource",
          "description": "Code block theme for PDF output, independently of the VS Code theme. Updates the open preview automatically. Default: one-light. Use Reset Setting to restore."
        },
        "localMarkdownPdf.paperSize": {
          "type": "string",
          "enum": [
            "A4",
            "A5",
            "Letter",
            "Legal"
          ],
          "default": "A4",
          "description": "PDF paper size. Default: A4. Use Reset Setting to restore.",
          "scope": "resource"
        },
        "localMarkdownPdf.orientation": {
          "type": "string",
          "enum": [
            "portrait",
            "landscape"
          ],
          "default": "portrait",
          "description": "PDF page orientation. Default: portrait. Use Reset Setting to restore.",
          "scope": "resource"
        },
        "localMarkdownPdf.fontSize": {
          "type": "number",
          "minimum": 8,
          "maximum": 24,
          "default": 11,
          "description": "Document body font size in points. Default: 11 pt. Use Reset Setting to restore.",
          "scope": "resource"
        },
        "localMarkdownPdf.pageNumbers": {
          "type": "boolean",
          "default": true,
          "description": "Show page numbers in the footer. Default: true. Use Reset Setting to restore.",
          "scope": "resource"
        },
        "localMarkdownPdf.pageNumberStyle": {
          "type": "string",
          "enum": [
            "current-total",
            "current",
            "page-of-total"
          ],
          "enumDescriptions": [
            "1 / 10",
            "1",
            "Page 1 of 10"
          ],
          "default": "current-total",
          "description": "Page number format. Default: current-total. Use Reset Setting to restore.",
          "scope": "resource"
        },
        "localMarkdownPdf.inlineCodeBackground": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "default": "#f1f3f5",
          "description": "Inline code background, as a six-digit hex color. Default: #f1f3f5. Use Reset Setting to restore.",
          "scope": "resource",
          "format": "color-hex"
        },
        "localMarkdownPdf.inlineCodeColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "default": "#172b4d",
          "description": "Inline code text, as a six-digit hex color. Default: #172b4d. Use Reset Setting to restore.",
          "scope": "resource",
          "format": "color-hex"
        },
        "localMarkdownPdf.marginTop": {
          "type": "number",
          "minimum": 5,
          "maximum": 40,
          "default": 22,
          "description": "Top page margin in millimeters. Default: 22 mm. Use Reset Setting to restore.",
          "scope": "resource"
        },
        "localMarkdownPdf.marginBottom": {
          "type": "number",
          "minimum": 5,
          "maximum": 40,
          "default": 24,
          "description": "Bottom page margin in millimeters. Default: 24 mm. Use Reset Setting to restore.",
          "scope": "resource"
        },
        "localMarkdownPdf.marginLeft": {
          "type": "number",
          "minimum": 5,
          "maximum": 40,
          "default": 18,
          "description": "Left page margin in millimeters. Default: 18 mm. Use Reset Setting to restore.",
          "scope": "resource"
        },
        "localMarkdownPdf.marginRight": {
          "type": "number",
          "minimum": 5,
          "maximum": 40,
          "default": 18,
          "description": "Right page margin in millimeters. Default: 18 mm. Use Reset Setting to restore.",
          "scope": "resource"
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "prepare:browser": "node scripts/browser.mjs",
    "package": "node scripts/package.mjs",
    "smoke": "node --import tsx scripts/smoke.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-sans-tc": "^5.3.1",
    "katex": "^0.19.0",
    "markdown-it": "^15.0.3",
    "mermaid": "^12.2.0",
    "pdfjs-dist": "^6.4.299",
    "playwright-core": "^1.64.1",
    "sanitize-html": "^2.18.1",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.5",
    "@types/sanitize-html": "^2.16.2",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "prettier": "3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/maggie62755/markdown-to-pdf.git"
  },
  "bugs": {
    "url": "https://github.com/maggie62755/markdown-to-pdf/issues"
  },
  "homepage": "https://github.com/maggie62755/markdown-to-pdf#readme",
  "icon": "assets/icon.png"
}
